# Local development template. Copy to .env and adjust:
#   cp .env.example .env
#
# .env is gitignored. This file is committed, so it must never
# contain real credentials — local defaults only.

# --- Postgres (consumed by docker-compose.yml) ---
POSTGRES_USER=syrenka
POSTGRES_PASSWORD=syrenka
POSTGRES_DB=syrenka

# --- Application connection ---
DATABASE_URL=postgresql://syrenka:syrenka@localhost:5432/syrenka

# --- Redis (docker-compose exposes 6379; no auth locally) ---
REDIS_URL=redis://localhost:6379

# --- Ingestion (services/analytics) ---
GIOS_MIN_INTERVAL=1.0
LOG_LEVEL=INFO
